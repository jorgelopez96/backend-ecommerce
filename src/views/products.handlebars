<h2>Productos</h2>
<div class="row" id="products-list">
  {{#each products}}
    <div class="col-md-4 mb-3">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">{{title}}</h5>
          <p class="card-text">{{description}}</p>
          <p><strong>Precio:</strong> ${{price}}</p>
          <p><strong>Stock:</strong> {{stock}}</p>
          <a href="/products/{{_id}}" class="btn btn-primary btn-sm">Ver detalle</a>
        </div>
      </div>
    </div>
  {{else}}
    <p>No hay productos disponibles.</p>
  {{/each}}
</div>
<nav class="mt-4">
  <ul class="pagination">
    {{#if hasPrevPage}}
      <li class="page-item">
        <a class="page-link" href="/products?page={{prevPage}}">Anterior</a>
      </li>
    {{/if}}
    <li class="page-item disabled">
      <span class="page-link">Página {{page}} de {{totalPages}}</span>
    </li>
    {{#if hasNextPage}}
      <li class="page-item">
        <a class="page-link" href="/products?page={{nextPage}}">Siguiente</a>
      </li>
    {{/if}}
  </ul>
</nav>